	measure 'N° Empates' =
			
			CALCULATE(
				COUNTA('Partidas Disputadas'[Resultado]),
				'Partidas Disputadas'[Resultado] IN { "Empate" }
			)
		formatString: 0
		lineageTag: c4df8bde-69db-4775-8dd9-2814277b4194

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "FilteredMeasure"
				}

		changedProperty = FormatString

	measure 'Média de Contagem de Público por Público' =
			
			AVERAGEX(
				KEEPFILTERS(VALUES('Partidas Disputadas'[Público])),
				CALCULATE(COUNTA('Partidas Disputadas'[Público]))
			)
		lineageTag: 67274e67-d2d3-4082-9d35-9ba3c2bd6d55

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "AveragePerCategory"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Média de Público Em Casa' =
			Calculate(
			AVERAGE('Partidas Disputadas'[Público]),'Partidas Disputadas'[Local] = "Casa")
		lineageTag: 62d4cd62-57a9-44b4-824a-57aecd72bc59

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "AveragePerCategory"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Passes Curtos' = ```
			
			var Passescertos = sum(Passes[Passes Curtos Certos])
			var PassesTentados = sum(Passes[Passes Curtos Tentados])
			var PassesErrados = PassesTentados - Passescertos
			var porcpass = Divide(Passescertos,PassesTentados)
			Return
			porcpass
			
			```
		lineageTag: 5d5b186c-2095-455a-aa90-a4dd635cfcf6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Img Jogador' = ```
			
			 VAR img = SELECTEDVALUE('Base Jogadores'[Imagem Principal])
			 VAR gols = sum('Gols e Minutos Jogados'[Total de Gols])
			 RETURN
			 " 
			 <style>
			 img{
			    width: 100%;
			    height: 100%;
			    object-fit: contain;
			    align-items: center;
			    }
			 p{
			    font-size: 16px;
			    }
			 </style>
			 <p>"&gols& " gols</p>
			 <img src ='"&img&"'>"
			
			```
		lineageTag: b8340678-2749-405e-ae73-e021dfdfe8e5

