	measure 'Gols Feitos Visual Balanço' = sum('Partidas Disputadas'[Gols Feitos])
		formatString: 0
		lineageTag: fe7355cc-4c90-496d-819c-2305e0defaa3

	measure 'Gols Sofridos Visual Balanço' = ```
