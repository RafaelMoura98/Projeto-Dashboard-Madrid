			```
		formatString: 0
		lineageTag: bf6a5fb3-66c6-4dc3-b954-30cd1c9ef7b1

	measure 'N° Vitórias' =
			
			CALCULATE(
				COUNTA('Partidas Disputadas'[Resultado]),
				'Partidas Disputadas'[Resultado] IN { "Vitória" }
			)
		formatString: 0
		lineageTag: 3f2b42b0-2d4e-40c1-b6bd-aeb2c7340500

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "FilteredMeasure"
				}

		changedProperty = FormatString

	measure 'N° Derrotas' =
			
			CALCULATE(
				COUNTA('Partidas Disputadas'[Resultado]),
				'Partidas Disputadas'[Resultado] IN { "Derrota" }
			)
		formatString: 0
		lineageTag: e6e97a0a-31bb-4981-afc6-d34f14a462b6

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "FilteredMeasure"
				}

