table Medidas
	lineageTag: d7b18ce9-dcb0-495d-b979-d8617a814ac0

	measure '% Passes Curtos' = ```
			
			var Passescertos = sum(Passes[Passes Curtos Certos])
			var PassesTentados = sum(Passes[Passes Curtos Tentados])
			var PassesErrados = PassesTentados - Passescertos
			var porcpass = Divide(Passescertos,PassesTentados)
			Return
			porcpass
			
			```
		displayFolder: Passes
		lineageTag: 5d5b186c-2095-455a-aa90-a4dd635cfcf6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Passes Longos' =
			
			var Passescertos = sum(Passes[Passes Longos Certos])
			var PassesTentados = sum(Passes[Passes Longos Tentados])
			var PassesErrados = PassesTentados - Passescertos
			var porcpass = Divide(Passescertos,PassesTentados)
			Return
			porcpass
		displayFolder: Passes
		lineageTag: fc3b47d9-8564-4333-b43f-45b1d1b9bce0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Passes Médios' =
			
			var Passescertos = sum(Passes[Passes Médios Certos])
			var PassesTentados = sum(Passes[Passes Médios Tentados])
			var PassesErrados = PassesTentados - Passescertos
			var porcpass = Divide(Passescertos,PassesTentados)
			Return
			porcpass
		displayFolder: Passes
		lineageTag: 09d9cd3e-123a-412b-9a2c-9837f0d86665

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'N° Derrotas' =
			
			CALCULATE(
				COUNTA('Partidas Disputadas'[Resultado]),
				'Partidas Disputadas'[Resultado] IN { "Derrota" }
			)
		formatString: 0
		displayFolder: Partidas
		lineageTag: e6e97a0a-31bb-4981-afc6-d34f14a462b6

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "FilteredMeasure"
				}

		changedProperty = FormatString

