				  "daxTemplateName": "AveragePerCategory"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Img Jogador' = ```
			
			 VAR img = SELECTEDVALUE('Base Jogadores'[Imagem Principal])
			 VAR gols = sum('Gols e Minutos Jogados'[Total de Gols])
			 Var ass = sum('Gols e Minutos Jogados'[Assistências])
			 RETURN
			 " 
			 <style>
			 img{
			    width: 100%;
			    height: 100%;
			    object-fit: contain;
			    align-items: center;
			    }
			 p{
			    font-size: 16px;
			    }
			 </style>
			 <p>"&gols& "   gols   "&ass&   "   assistências</p>
			 <img src ='"&img&"'>"
			
			```
		displayFolder: Visuais
		lineageTag: b8340678-2749-405e-ae73-e021dfdfe8e5

